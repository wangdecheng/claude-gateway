#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NODE_BIN="/Users/wangdecheng/.nvm/versions/node/v22.16.0/bin"

pids="$(lsof -tiTCP:3000 -sTCP:LISTEN || true)"
if [[ -n "$pids" ]]; then
  kill $pids
  sleep 1
fi

cd "$ROOT_DIR/frontend"
PATH="$NODE_BIN:$PATH" npm run dev
